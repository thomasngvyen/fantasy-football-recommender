# Copy to backend/.env and adjust values. Never commit .env.

# "live" uses Sleeper + fixture data; "mock" is reserved for future offline demos
DATA_MODE=live

# SQLite path (relative to backend/ when running commands from there)
DATABASE_URL=sqlite:///./fantasy.db

# Comma-separated browser origins allowed by CORS (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# Optional — enables weather modifiers during sync (5-day forecast window only)
OPENWEATHER_API_KEY=
